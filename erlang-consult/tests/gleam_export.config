{<<"name">>, <<"wibble"/utf8>>}.
{<<"app">>, <<"wibble"/utf8>>}.
{<<"version">>, <<"1.0.0"/utf8>>}.
{<<"description">>, <<"Splits on " " by default, café"/utf8>>}.
{<<"licenses">>, [<<"Apache-2.0"/utf8>>]}.
{<<"build_tools">>, [<<"gleam"/utf8>>]}.
{<<"links">>, [
  {<<"Website"/utf8>>, <<"https://gleam.run/"/utf8>>},
  {<<"Repository"/utf8>>, <<"https://github.com/gleam-lang/wibble"/utf8>>}
]}.
{<<"requirements">>, [
  {<<"gleam_stdlib"/utf8>>, [
  {<<"app">>, <<"gleam_stdlib"/utf8>>},
    {<<"optional">>, false},
    {<<"requirement">>, <<">= 1.0.0 and < 2.0.0"/utf8>>}
  ]}
]}.
{<<"files">>, [
  <<"README.md"/utf8>>,
  <<"gleam.toml"/utf8>>,
  <<"src/wibble.app.src"/utf8>>,
  <<"src/wibble.erl"/utf8>>,
  <<"src/wibble.gleam"/utf8>>
]}.
